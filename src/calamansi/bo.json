  "about.what_body_2_prefix": "ཛ་དྲག་འདི་ཤིན་ཏུ་རྒྱུན་ལྡན་གྱི་གྲལ་ཁར་ཡོད། ཡིག་ཆ་ཐམས་ཅད་ལ་ཉམས་མྱོང་ཐུམ་ཚོགས་ཀྱི་འགྲེལ་བཤད་གཏན་འཁེལ་ཆགས་པར་འགྲོ་ཕྱིར་གལ་ཆེ། མཛོད་འདི་ཞིབ་བསྐྱར་གྱི་ལས་འགན་དངོས་ལས་བཟོས་ཏེ་སྔལ་སྐད་གཞི་གྲངས། གཏན་འཁེལ། ཚད་ལྡན། དང་ ",
  "about.what_body_2_suffix": "ལ་ཞིབ་བཤེར་བྱས་ཏེ་ AI ཡིས་བཟོ་ལེགས་བཅོས་བྱས་པ།",
  "about.what_wcag": "གཞི་གྲངས་འདིས་WCAG 2.2 རིམ་པ་A དང་AAའདོམས་ཤིང་། ཚོགས་པ་ཕལ་ཆེར་གྱིས་བེད་སྤྱོད་བྱེད་པའི་ཚད་གཞི་དང་ཐོབ་ཐང་འབྲེལ་གྱི་ཁྲིམས་ལུགས་མང་པོའི་རྩ་གཞི་ཡིན། རིམ་པ་AAAའགྲུབ་ཚད་ཁ་གྲངས་ཅིག་ཀྱང་ཡོད་དེ། ཐོབ་ཐང་རྒྱུན་ལུགས་ཀྱི་ཚོགས་པས་ལོག་བྱེད་ཀྱི་རྣམ་པ་གལ་ཆེན་དུ་བལྟས་ན་ཚུད་ཡོད།",
  "about.examples_intro": "དཔེ་མཚོན་ནི་འདི་དག་ཡིན།",
  "about.features_heading": "ཁྱད་ཆོས་གལ་ཆེ་བ།",
  "about.feature_ai_label": "AI རོགས་རམ།",
  "about.feature_ai_body": "AI བེད་སྤྱོད་བྱས་ནས་ཁྱེད་ཀྱི་མཆན་ལྟར་ཐོར་བུ་གསར་འབྲི་བྱེད། Anthropic、OpenAI、ཡང་ན་Googleལས་ API ལྡེ་མིག་རང་ལ་གཟིགས་རོགས། ལྡེ་མིག་ཁྱེད་ཀྱི་བར་སྣང་ལ་མི་འགྲོ་ཞིང་ང་ཚོར་ནམ་ཡང་སྐྱེལ་མི་འབྱུང་། གཤམ་གྱི་",
  "about.feature_agentic_label": "སྔར་བཞིན་ཉམས་འབྲི་དང་མཐུན་སྒྲིག",
  "about.feature_agentic_body": "Claude (Anthropic) སྤྱོད་ན་སྔར་བཞིན་ཉམས་འབྲི་དང་མཐུན་སྒྲིག་ཀྱང་ཕྱེ་ཆོག། AI ཡིས་སྔར་བྱས་བསྐྱར་འབྲི་ཉམས་མྱོང་གི་དཔེ་གཞི་འཚོལ་ཏེ་ཁྱེད་ཀྱི་ཡིག་ཉམས་དང་ཞིབ་འཕྲི་རྩ་ཁུངས་ལྟར་སྒྲིག་ཀྱི་ཡིན། མིག་སྔར་རྙེད་དོན་ཁོ་ན་བསྐྱར་འབྲི་མི་བྱེད།",
  "about.feature_languages_label": "སྐད་ཡིག 50+",
  "about.feature_languages_body": "དཀར་ཆག་འདི་RTL རྒྱབ་རྟེན་ཡོད་པའི་ཡིག་གཞུང་ 50 ལྷག་ལ་ཐོབ་ཐུབ། ང་ལ་སྐད་ཡིག་དང་རིག་གཞུང་། སྐད་རིགས་རིག་པར་དགའ་ཞིང་འོད་སྣང་ཆེ། སྐད་ཡིག་འདི་ཐམས་ཅད་ཚུད་གཏོང་བ་ནི་རྩེད་མོའི་ལམ་ལྡེ་ཞིག་ལྟ་བུ་རེད། ཆ་རེ་ཚོད་ལྟ། ཆ་རེ་གྲོ་ལམ། ཆ་རེ་ཅུང་གཡེང་བར་གྱུར། བསྒྱུར་བཅོས་AI གིས་བྱས་པས། བསྒྱུར་ཐབས་ལ་ཡིད་ཆེས་མ་འཇོག་རོགས། བསྒྱུར་འཕྲད་ཀྱི་འདེམས་སྒྲུག་",
  "about.feature_pinning_label": "Pinned Results",
  "about.feature_pinning_body": "Pin any finding to keep it at the top across all searches and views. Use the priority arrows to rank others, star to float a finding to the very top, or archive to remove it from view.",
  "about.feature_a11y_label": "ཐོབ་ཐང་ལ་ཐོག་མར་། AI གཉིས་པར།",
  "about.feature_a11y_body": "WCAG 2.2 ལར་གསོས། གཏད་སྒྲོམ་དོ་དམ། གསོན་སྐུལ་མང་། མཐེབ་ཀྱིས་ལག་ལེན་ཆ་ཚང་། འགུལ་བསྐྱོད་ཉུང་གི་རྒྱབ་རྟེན། མདོག་དོ་ལྡན་གྱི་ཁ་དོག་ཐབས་ལམ་བཅས་ཚུད་ཡོད།",
  "about.sources_heading": "གཞི་གྲངས་འབྱུང་ཁུངས།",
