{
  "name": "a11ytexthelper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint src/",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:md": "markdownlint \"docs/**/*.md\" README.md",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "translate": "node scripts/translate-missing.mjs",
    "build:extension": "vite build --config vite.extension.config.js",
    "build:extension:firefox": "vite build --config vite.firefox.config.js",
    "electron:dev": "NODE_ENV=development concurrently \"vite\" \"electron electron/main.js\"",
    "electron:build": "vite build && electron-builder --config electron/electron-builder.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "fuse.js": "^7.0.0",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "markdownlint-cli": "^0.48.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.10"
  }
}
